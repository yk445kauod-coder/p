# Copy to .env and fill in. These are publishable values, safe to ship in the bundle.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# VAPID public key for Web Push (the matching private key lives in the edge
# function's secrets, never here).
EXPO_PUBLIC_VAPID_PUBLIC_KEY=<base64url-public-key>
