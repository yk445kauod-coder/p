{
  "name": "tracebook-api",
  "version": "1.0.0",
  "private": true,
  "description": "TraceBook serverless backend on Cloudflare Workers (D1 + KV + OpenRouter proxy)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute tracebook --file=./schema.sql --remote",
    "db:init:local": "wrangler d1 execute tracebook --file=./schema.sql --local",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
