# Cloudflare Pages headers for the installable PWA.
#
# The service worker must never be served stale, or a new deploy can be pinned
# behind an old cache. Hashed bundles under /app/assets are immutable.

/app/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

/app/index.html
  Cache-Control: no-cache

/app/manifest.webmanifest
  Cache-Control: no-cache
  Content-Type: application/manifest+json

/app/_expo/static/js/web/*
  Cache-Control: public, max-age=31536000, immutable

/app/assets/*
  Cache-Control: public, max-age=31536000, immutable

/app/icons/*
  Cache-Control: public, max-age=604800
